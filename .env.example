# ---- Core ----
NODE_ENV=development
DATABASE_URL="postgresql://dropreel:dropreel@127.0.0.1:5432/dropreel?connection_limit=25&pool_timeout=20"
SHADOW_DATABASE_URL=postgresql://dropreel:dropreel@127.0.0.1:5432/dropreel_shadow
REDIS_URL=redis://127.0.0.1:6379

# ---- Secrets (generate with: openssl rand -hex 32) ----
JWT_SECRET=change-me-dev-only-0000000000000000000000000000000000000000
PLAYBACK_TOKEN_SECRET=change-me-dev-only-1111111111111111111111111111111111111111
IP_HASH_SALT=change-me-dev-only-2222222222222222222222222222222222222222

# ---- Object storage ----
# Production: Cloudflare R2. Zero egress is what makes the unit economics work;
# per-GB egress pricing (S3, GCS) costs multiples of what the ads earn per view.
# Dev: MinIO via docker-compose, which speaks the same S3 API.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=dropreel-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public delivery host sitting in front of the bucket (CDN origin).
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9000/dropreel-media

# ---- URLs ----
API_PORT=4000
API_PUBLIC_URL=http://127.0.0.1:4000
WEB_PUBLIC_URL=http://127.0.0.1:3000

# ---- Transcoding ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCODE_CONCURRENCY=2
TRANSCODE_TMP_DIR=./tmp-media

# ---- Compliance ----
# Perceptual-hash matching provider. Blocking at ingest is not optional.
HASH_MATCH_PROVIDER=internal
HASH_MATCH_API_KEY=
DMCA_AGENT_EMAIL=dmca@example.com
DMCA_AGENT_NAME="Designated Agent"
DMCA_AGENT_ADDRESS="1 Example Street, Example City, EX1 1EX"

# ---- GeoIP ----
# MaxMind GeoLite2 databases; without them everything falls back to tier 3.
GEOIP_COUNTRY_DB=./data/GeoLite2-Country.mmdb
GEOIP_ASN_DB=./data/GeoLite2-ASN.mmdb
